# GAMEPULSE Backend Environment Configuration
# Copy this file to .env and provide appropriate values.

# Server Environment
NODE_ENV=development
PORT=5001

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017/gamepulse
MONGODB_URI=mongodb://127.0.0.1:27017/gamepulse

# CORS & Frontend Origin
# For multiple origins, comma-separate: http://localhost:5173,https://yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Admin Security & Authentication
# JWT secret for signing auth tokens (minimum 32 characters in production)
JWT_SECRET=development_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# First-Admin One-Time Bootstrap Token
# Required to execute the first-time administrator creation endpoint or CLI script
ADMIN_BOOTSTRAP_TOKEN=your_secure_bootstrap_token_here

# Media Uploads (Cloudinary - Optional in development)
# When omitted, media upload routes return a clean unconfigured message
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Canonical Site URL (for sitemap and canonical link generation)
SITE_URL=http://localhost:5173
